# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored — never commit real secrets.

# Server-side only — used by app/api/chat/route.ts. Never exposed to the
# client (no NEXT_PUBLIC_ prefix).
ANTHROPIC_API_KEY=

# Signs the chat widget's short-lived session tokens (lib/chat/session.ts).
# Any long random string — e.g. `openssl rand -base64 32`.
CHAT_SESSION_SECRET=
