# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# reference-only copy of the pre-migration static site
/legacy-static

# local agent tooling state — machine-local settings/commands/etc stay
# ignored by default; skills are explicitly un-ignored below since they're
# shared project knowledge worth version-controlling. Note: the parent has
# to be a glob (/.claude/*), not a bare directory match (/.claude) — once
# git treats a directory itself as ignored it won't descend into it at all,
# so a deeper "!" negation below would never even get evaluated.
/.claude/*
!/.claude/skills/
